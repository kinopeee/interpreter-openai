{
  "version": 2,
  "description": "Audio pipeline contract v2: 100 ms float frames, RMS-based adaptive gain with per-frame clip limiter and sample ramp. Packetizer, PCM16 conversion and loss sections are carried over unchanged from v1.",
  "format": {
    "sampleRate": 24000,
    "bytesPerSample": 2,
    "frameDurationMilliseconds": 100,
    "samplesPerFrame": 2400,
    "bytesPerFrame": 4800,
    "channels": 1,
    "endianness": "little"
  },
  "packetizer": [
    {
      "name": "exactly one frame",
      "steps": [
        {
          "kind": "append",
          "byteCount": 4800,
          "expectedFrameCount": 1
        }
      ],
      "expectedPendingBytes": 0,
      "flush": {
        "expectedFrameBytes": null
      }
    },
    {
      "name": "partial input produces no frame",
      "steps": [
        {
          "kind": "append",
          "byteCount": 4799,
          "expectedFrameCount": 0
        }
      ],
      "expectedPendingBytes": 4799,
      "flush": {
        "expectedFrameBytes": 4800,
        "expectedTrailingZeroBytes": 1
      }
    },
    {
      "name": "empty input is ignored",
      "steps": [
        {
          "kind": "append",
          "byteCount": 0,
          "expectedFrameCount": 0
        }
      ],
      "expectedPendingBytes": 0,
      "flush": {
        "expectedFrameBytes": null
      }
    },
    {
      "name": "multiple frames and a remainder",
      "steps": [
        {
          "kind": "append",
          "byteCount": 12000,
          "expectedFrameCount": 2
        }
      ],
      "expectedPendingBytes": 2400,
      "flush": {
        "expectedFrameBytes": 4800,
        "expectedTrailingZeroBytes": 2400
      }
    },
    {
      "name": "remainders accumulate across appends",
      "steps": [
        {
          "kind": "append",
          "byteCount": 3000,
          "expectedFrameCount": 0
        },
        {
          "kind": "append",
          "byteCount": 3000,
          "expectedFrameCount": 1
        }
      ],
      "expectedPendingBytes": 1200,
      "flush": {
        "expectedFrameBytes": 4800,
        "expectedTrailingZeroBytes": 3600
      }
    },
    {
      "name": "reset drops the remainder",
      "steps": [
        {
          "kind": "append",
          "byteCount": 1000,
          "expectedFrameCount": 0
        },
        {
          "kind": "reset"
        }
      ],
      "expectedPendingBytes": 0,
      "flush": {
        "expectedFrameBytes": null
      }
    }
  ],
  "packetizerContinuity": {
    "name": "concatenating all emitted frames plus the padded flush reproduces the input followed by silence",
    "appendByteCounts": [
      1234,
      5678,
      9012
    ],
    "totalInputBytes": 15924,
    "expectedEmittedFrameCount": 3,
    "expectedFlushFrameBytes": 4800,
    "expectedTrailingZeroBytes": 3276
  },
  "float32ToPcm16": [
    {
      "name": "zero",
      "sample": 0.0,
      "gain": 1.0,
      "expected": 0
    },
    {
      "name": "full scale positive",
      "sample": 1.0,
      "gain": 1.0,
      "expected": 32767
    },
    {
      "name": "full scale negative",
      "sample": -1.0,
      "gain": 1.0,
      "expected": -32767
    },
    {
      "name": "clips above one",
      "sample": 2.5,
      "gain": 1.0,
      "expected": 32767
    },
    {
      "name": "clips below minus one",
      "sample": -2.5,
      "gain": 1.0,
      "expected": -32767
    },
    {
      "name": "gain is applied before clipping",
      "sample": 0.5,
      "gain": 4.0,
      "expected": 32767
    },
    {
      "name": "gain scales a quiet sample",
      "sample": 0.1,
      "gain": 2.0,
      "expected": 6553
    },
    {
      "name": "rounds half away from zero",
      "sample": 0.5,
      "gain": 1.0,
      "expected": 16384
    }
  ],
  "float32Framing": {
    "frameSamples": 2400,
    "cases": [
      {
        "name": "exact frame emits once",
        "appendSampleCounts": [
          2400
        ],
        "expectedFrameCounts": [
          1
        ],
        "expectedPendingSamples": 0,
        "flushPadsSilenceSamples": null
      },
      {
        "name": "partial appends accumulate",
        "appendSampleCounts": [
          1000,
          1000,
          1000
        ],
        "expectedFrameCounts": [
          0,
          0,
          1
        ],
        "expectedPendingSamples": 600,
        "flushPadsSilenceSamples": 1800
      },
      {
        "name": "large append emits several frames",
        "appendSampleCounts": [
          5000
        ],
        "expectedFrameCounts": [
          2
        ],
        "expectedPendingSamples": 200,
        "flushPadsSilenceSamples": 2200
      },
      {
        "name": "empty pending does not flush",
        "appendSampleCounts": [
          4800
        ],
        "expectedFrameCounts": [
          2
        ],
        "expectedPendingSamples": 0,
        "flushPadsSilenceSamples": null
      }
    ]
  },
  "frameStatistics": {
    "cases": [
      {
        "name": "mixed samples",
        "samples": [
          0.3,
          -0.4,
          0.0
        ],
        "expectedRms": 0.2886751,
        "expectedPeak": 0.4
      },
      {
        "name": "non-finite samples are skipped",
        "samples": [
          0.3,
          "nan",
          -0.4,
          "infinity",
          0.0
        ],
        "expectedRms": 0.2886751,
        "expectedPeak": 0.4
      },
      {
        "name": "all non-finite samples yield non-finite statistics",
        "samples": [
          "nan",
          "-infinity"
        ],
        "expectedRms": "nan",
        "expectedPeak": "nan"
      },
      {
        "name": "silence",
        "samples": [
          0.0,
          0.0,
          0.0,
          0.0
        ],
        "expectedRms": 0.0,
        "expectedPeak": 0.0
      }
    ]
  },
  "gain": {
    "constants": {
      "frameSamples": 2400,
      "minimumGain": 1.0,
      "maximumGain": 8.0,
      "defaultInitialGain": 4.0,
      "targetRms": 0.1,
      "speechRatio": 3.16,
      "speechAbsoluteFloor": 0.003,
      "noiseCeiling": 0.01,
      "noiseFloorMinimum": 0.0001,
      "noiseFloorRise": 1.01,
      "gainRise": 1.12,
      "gainFall": 0.8,
      "clipCeiling": 0.9,
      "rampSamples": 120
    },
    "tolerance": 0.0005,
    "cases": [
      {
        "name": "initial gain above the maximum is clamped",
        "initialGain": 100.0,
        "frames": [
          {
            "rms": 0.0,
            "peak": 0.0
          }
        ],
        "expectedTrace": [
          {
            "gain": 8.0,
            "appliedGain": 8.0
          }
        ],
        "expectedFinal": {
          "gain": 8.0,
          "appliedGain": 8.0
        }
      },
      {
        "name": "initial gain below the minimum is clamped",
        "initialGain": 0.1,
        "frames": [
          {
            "rms": 0.0,
            "peak": 0.0
          }
        ],
        "expectedTrace": [
          {
            "gain": 1.0,
            "appliedGain": 1.0
          }
        ],
        "expectedFinal": {
          "gain": 1.0,
          "appliedGain": 1.0
        }
      },
      {
        "name": "silence keeps the gain",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.0,
            "peak": 0.0,
            "repeat": 5
          }
        ],
        "expectedTrace": [
          {
            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 4.0,
            "appliedGain": 4.0
          }
        ],
        "expectedFinal": {
          "gain": 4.0,
          "appliedGain": 4.0
        }
      },
      {
        "name": "quiet noise never raises the gain",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.001,
            "peak": 0.003,
            "repeat": 30
          }
        ],
        "expectedFinal": {
          "gain": 4.0,
          "appliedGain": 4.0
        }
      },
      {
        "name": "noise above the ceiling lowers the gain to the noise cap",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.004,
            "peak": 0.012,
            "repeat": 6
          }
        ],
        "expectedTrace": [
          {
            "gain": 3.2,
            "appliedGain": 3.2
          },
          {
            "gain": 2.56,
            "appliedGain": 2.56
          },
          {
            "gain": 2.5,
            "appliedGain": 2.5
          },
          {
            "gain": 2.5,
            "appliedGain": 2.5
          },
          {
            "gain": 2.5,
            "appliedGain": 2.5
          },
          {
            "gain": 2.5,
            "appliedGain": 2.5
          }
        ],
        "expectedFinal": {
          "gain": 2.5,
          "appliedGain": 2.5
        }
      },
