            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 4.48,
            "appliedGain": 4.48
          },
          {
            "gain": 4.48,
            "appliedGain": 4.48
          },
          {
            "gain": 4.48,
            "appliedGain": 4.48
          },
          {
            "gain": 4.48,
            "appliedGain": 4.48
          },
          {
            "gain": 5.0,
            "appliedGain": 5.0
          }
        ],
        "expectedFinal": {
          "gain": 5.0,
          "appliedGain": 5.0
        }
      },
      {
        "name": "negative statistics are treated as zero",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": -0.5,
            "peak": -0.5,
            "repeat": 2
          }
        ],
        "expectedTrace": [
          {
            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 4.0,
            "appliedGain": 4.0
          }
        ],
        "expectedFinal": {
          "gain": 4.0,
          "appliedGain": 4.0
        }
      },
