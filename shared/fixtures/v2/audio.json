            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 3.333333,
            "appliedGain": 1.125
          },
          {
            "gain": 3.333333,
            "appliedGain": 3.333333
          }
        ],
        "expectedFinal": {
          "gain": 3.333333,
          "appliedGain": 3.333333
        }
      },
      {
        "name": "the limiter does not change the sustained gain",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.001,
            "peak": 0.003
          },
          {
            "rms": 0.02,
            "peak": 0.5
          },
          {
            "rms": 0.02,
            "peak": 0.06
          }
        ],
        "expectedTrace": [
          {
            "gain": 4.0,
            "appliedGain": 4.0
          },
          {
            "gain": 4.48,
            "appliedGain": 1.8
          },
