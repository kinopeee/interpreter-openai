          }
        ],
        "expectedFinal": {
          "gain": 3.2,
          "appliedGain": 1.0
        }
      },
      {
        "name": "a sustained noise step is eventually capped",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.001,
            "peak": 0.003
          },
          {
            "rms": 0.004,
            "peak": 0.012,
            "repeat": 200
          }
        ],
        "expectedFinal": {
          "gain": 2.5,
          "appliedGain": 2.5
        }
      },
      {
        "name": "silence then steady noise is eventually capped",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.0,
            "peak": 0.0,
            "repeat": 5
          },
          {
            "rms": 0.004,
            "peak": 0.012,
            "repeat": 400
          }
        ],
        "expectedFinal": {
          "gain": 2.5,
          "appliedGain": 2.5
        }
      },
      {
        "name": "non-finite statistics are ignored",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.001,
            "peak": 0.003
          },
          {
            "rms": 0.02,
            "peak": 0.06
          },
          {
            "rms": "nan",
            "peak": 0.06
          },
          {
            "rms": 0.02,
            "peak": "infinity"
          },
          {
            "rms": "-infinity",
            "peak": "nan"
          },
          {
            "rms": 0.02,
            "peak": 0.06
          }
