      {
        "name": "a click limits only its own frame and keeps the sustained gain",
        "initialGain": 4.0,
        "frames": [
          {
            "rms": 0.001,
            "peak": 0.003
          },
          {
            "rms": 0.03,
            "peak": 0.8
          },
          {
            "rms": 0.03,
