{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinopeee/interpreter-openai/shared/fixtures/v1/schema/api-key.schema.json",
  "title": "API key normalization fixtures",
  "type": "object",
  "required": ["version", "normalize"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "normalize": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "status"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "input": { "type": "string" },
          "status": { "enum": ["empty", "malformed", "valid"] },
          "expected": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "valid" } } },
            "then": { "required": ["expected"] }
          }
        ]
      }
    }
  }
}
