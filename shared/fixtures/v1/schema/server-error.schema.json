{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinopeee/interpreter-openai/shared/fixtures/v1/schema/server-error.schema.json",
  "title": "Server error classification contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "description",
    "dispositions",
    "terminationPrecedence",
    "allowlists",
    "recoverableServerError",
    "transcriptionFailed",
    "handshakeHttpStatus",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "dispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keepAlive", "recover", "halt"],
      "properties": {
        "keepAlive": { "type": "string" },
        "recover": { "type": "string" },
        "halt": { "type": "string" }
      }
    },
    "terminationPrecedence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "authenticationFailed",
          "fatalServerError",
          "receiveOverflow",
          "recoverableServerError",
          "transportFailure"
        ]
      }
    },
    "allowlists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transportCode", "keepAliveCodes", "haltCodes", "recoverCodes", "recoverTypes"],
      "properties": {
        "transportCode": { "const": "transport" },
        "keepAliveCodes": { "$ref": "#/$defs/codeList" },
        "haltCodes": { "$ref": "#/$defs/codeList" },
        "recoverCodes": { "$ref": "#/$defs/codeList" },
        "recoverTypes": { "$ref": "#/$defs/codeList" }
      }
    },
    "recoverableServerError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorKind", "errorMessageKey", "isRecoverable"],
      "properties": {
        "errorKind": { "const": "recoverableServerError" },
        "errorMessageKey": { "type": "string" },
        "isRecoverable": { "const": true }
      }
    },
    "transcriptionFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "unknownDisposition", "cases"],
      "properties": {
        "description": { "type": "string" },
        "unknownDisposition": { "const": "keepAlive" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "errorType", "code", "expected"],
            "properties": {
              "name": { "type": "string" },
              "errorType": { "type": ["string", "null"] },
              "code": { "type": ["string", "null"] },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["disposition", "termination"],
                "properties": {
                  "disposition": { "type": "string", "enum": ["keepAlive", "recover", "halt"] },
                  "termination": {
                    "type": "string",
                    "enum": ["none", "authenticationFailed", "fatalServerError", "recoverableServerError", "transportFailure"]
                  },
                  "sanitizedMessage": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "handshakeHttpStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "haltAuthenticationStatusCodes", "recoverableServerErrorStatusCodes", "cases"],
      "properties": {
        "description": { "type": "string" },
        "haltAuthenticationStatusCodes": { "$ref": "#/$defs/statusCodeList" },
        "recoverableServerErrorStatusCodes": { "$ref": "#/$defs/statusCodeList" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "statusCode", "expected"],
            "properties": {
              "name": { "type": "string" },
              "statusCode": {
                "anyOf": [
                  { "type": "integer", "minimum": 100, "maximum": 599 },
                  { "type": "null" }
                ]
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["disposition", "termination"],
                "properties": {
                  "disposition": { "type": "string", "enum": ["recover", "halt"] },
                  "termination": {
                    "type": "string",
                    "enum": ["authenticationFailed", "recoverableServerError", "transportFailure"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "errorType", "code", "message", "expected"],
        "properties": {
          "name": { "type": "string" },
          "errorType": { "type": ["string", "null"] },
          "code": { "type": ["string", "null"] },
          "message": { "type": "string" },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disposition", "termination"],
            "properties": {
              "disposition": { "type": "string", "enum": ["keepAlive", "recover", "halt"] },
              "termination": {
                "type": "string",
                "enum": [
                  "none",
                  "authenticationFailed",
                  "fatalServerError",
                  "recoverableServerError",
                  "transportFailure"
                ]
              },
              "sanitizedMessage": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "statusCodeList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 100, "maximum": 599 }
    },
    "codeList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
