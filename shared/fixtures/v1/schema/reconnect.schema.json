{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interpreter-openai/shared/fixtures/v1/reconnect.schema.json",
  "title": "Reconnect budget fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "description", "policy", "rules", "budgetExhausted", "attemptLimit", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialBackoffMs",
        "backoffMultiplier",
        "maxBackoffMs",
        "jitterMaxMs",
        "maxAttempts",
        "totalBudgetMs",
        "stablePeriodMs",
        "attemptTimeoutMs"
      ],
      "properties": {
        "initialBackoffMs": { "type": "integer", "minimum": 1 },
        "backoffMultiplier": { "type": "integer", "minimum": 1 },
        "maxBackoffMs": { "type": "integer", "minimum": 1 },
        "jitterMaxMs": { "type": "integer", "minimum": 0 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "totalBudgetMs": { "type": "integer", "minimum": 1 },
        "stablePeriodMs": { "type": "integer", "minimum": 0 },
        "attemptTimeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "budgetExhausted": { "$ref": "#/$defs/messageKey" },
    "attemptLimit": { "$ref": "#/$defs/messageKey" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "events"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["atMs", "kind"],
                  "properties": {
                    "atMs": { "type": "integer", "minimum": 0 },
                    "kind": { "const": "listening" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["atMs", "kind", "expected"],
                  "properties": {
                    "atMs": { "type": "integer", "minimum": 0 },
                    "kind": { "const": "failure" },
                    "expected": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["decision", "attempt", "backoffMs"],
                          "properties": {
                            "decision": { "const": "wait" },
                            "attempt": { "type": "integer", "minimum": 1 },
                            "backoffMs": { "type": "integer", "minimum": 0 }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["decision"],
                          "properties": {
                            "decision": { "enum": ["attemptLimit", "budgetExhausted"] }
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "messageKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorMessageKey"],
      "properties": {
        "errorMessageKey": { "type": "string", "pattern": "^error\\." }
      }
    }
  }
}
