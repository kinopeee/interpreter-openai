{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinopeee/interpreter-openai/shared/fixtures/v1/schema/routing.schema.json",
  "title": "Dual realtime audio routing fixtures",
  "type": "object",
  "required": [
    "version",
    "prerollFrameLimit",
    "consecutiveTranslationFailureLimit",
    "scriptSwitchGate",
    "cases",
    "targetSelection",
    "prerollWindow",
    "switchStability"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "prerollFrameLimit": { "const": 40 },
    "consecutiveTranslationFailureLimit": { "const": 3 },
    "scriptSwitchGate": {
      "type": "object",
      "required": ["minimumLatinWords", "minimumLatinScalars", "minimumJapaneseScalars"],
      "additionalProperties": false,
      "properties": {
        "minimumLatinWords": { "type": "integer" },
        "minimumLatinScalars": { "type": "integer" },
        "minimumJapaneseScalars": { "type": "integer" }
      }
    },
    "targetSelectionDescription": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "steps", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "pair": { "enum": ["ja-en", "ja-es", "en-es"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind", "frame"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "appendFrame" },
                    "frame": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "target"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "selectTranslationTarget" },
                    "target": { "enum": ["en", "ja", "es", null] }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "resetAudioRouting" }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "const": "translationSendFailure" }
                  }
                }
              ]
            }
          },
          "expected": {
            "type": "object",
            "required": ["sourceFrames", "frames"],
            "additionalProperties": false,
            "properties": {
              "sourceFrames": { "$ref": "#/$defs/frameList" },
              "frames": {
                "type": "object",
                "minProperties": 2,
                "additionalProperties": { "$ref": "#/$defs/frameList" },
                "propertyNames": { "enum": ["en", "ja", "es"] }
              },
              "transportErrorCount": { "type": "integer", "minimum": 0 },
              "translationPumpHalted": { "type": "boolean" },
              "signalsSessionReconnect": { "type": "boolean" }
            }
          }
        }
      }
    },
    "targetSelection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "pair", "evidence"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "pair": { "enum": ["ja-en", "ja-es", "en-es"] },
          "initialTarget": { "enum": ["en", "ja", "es", null] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["evidence", "expectedTarget"],
              "additionalProperties": false,
              "properties": {
                "evidence": { "enum": ["japanese", "english", "spanish", "ambiguousLatin", "none"] },
                "oppositeRun": { "$ref": "#/$defs/oppositeRun" },
                "expectedTarget": { "enum": ["en", "ja", "es", null] },
                "expectedReverseEvidenceCount": { "type": "integer", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "switchStability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "pair", "initialTarget", "splits", "expectedSwitchCount", "expectedFinalTarget", "expectedSplitOffset"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "pair": { "enum": ["ja-en", "ja-es"] },
          "initialTarget": { "enum": ["en", "ja", "es"] },
          "splits": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["deltas", "expectedSwitchAtDelta", "expectedSourceLengthAtSwitch"],
              "additionalProperties": false,
              "properties": {
                "deltas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "expectedSwitchAtDelta": { "type": ["integer", "null"] },
                "expectedSourceLengthAtSwitch": { "type": ["integer", "null"] }
              }
            }
          },
          "expectedSwitchCount": { "type": "integer", "minimum": 0 },
          "expectedFinalTarget": { "enum": ["en", "ja", "es"] },
          "expectedSplitOffset": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "prerollWindow": {
      "type": "object",
      "required": [
        "name",
        "appendFrameCount",
        "thenSelectTranslationTarget",
        "expectedFlushedFrameCount",
        "expectedFirstFlushedFrameIndex",
        "expectedLastFlushedFrameIndex"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "appendFrameCount": { "type": "integer", "minimum": 1 },
        "thenSelectTranslationTarget": { "enum": ["en", "ja", "es"] },
        "expectedFlushedFrameCount": { "type": "integer", "minimum": 0 },
        "expectedFirstFlushedFrameIndex": { "type": "integer", "minimum": 0 },
        "expectedLastFlushedFrameIndex": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "frameList": { "type": "array", "items": { "type": "string" } },
    "oppositeRun": {
      "type": "object",
      "required": ["latinWords", "latinScalars", "japaneseScalars"],
      "additionalProperties": false,
      "properties": {
        "latinWords": { "type": "integer" },
        "latinScalars": { "type": "integer" },
        "japaneseScalars": { "type": "integer" }
      }
    }
  }
}
