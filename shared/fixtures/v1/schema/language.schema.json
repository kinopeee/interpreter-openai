{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinopeee/interpreter-openai/shared/fixtures/v1/schema/language.schema.json",
  "title": "Spoken language detection fixtures",
  "type": "object",
  "required": ["version", "recentEvidenceWindow", "enEsWindow", "exclusiveWords", "evidence", "recentEvidence", "targets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "recentEvidenceWindow": { "const": 16 },
    "enEsWindow": { "const": 8 },
    "exclusiveWords": {
      "type": "object",
      "required": ["es", "en"],
      "additionalProperties": false,
      "properties": {
        "es": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "en": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "evidence", "detect"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "pair": { "$ref": "#/$defs/pair" },
          "input": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "detect": { "$ref": "#/$defs/language" }
        }
      }
    },
    "recentEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "window", "expected", "fullEvidence"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "pair": { "$ref": "#/$defs/pair" },
          "input": { "type": "string" },
          "window": { "type": "integer", "minimum": 0 },
          "expected": { "$ref": "#/$defs/evidence" },
          "fullEvidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["pair", "languages", "mappings"],
        "additionalProperties": false,
        "properties": {
          "pair": { "$ref": "#/$defs/pair" },
          "languages": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "enum": ["ja", "en", "es"] }
          },
          "mappings": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["language", "translationTarget", "counterpart"],
              "additionalProperties": false,
              "properties": {
                "language": { "$ref": "#/$defs/language" },
                "translationTarget": { "enum": ["en", "ja", "es", null] },
                "counterpart": { "$ref": "#/$defs/language" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pair": { "enum": ["ja-en", "ja-es", "en-es"] },
    "evidence": { "enum": ["japanese", "english", "spanish", "ambiguousLatin", "none"] },
    "language": { "enum": ["japanese", "english", "spanish", "unknown"] }
  }
}
