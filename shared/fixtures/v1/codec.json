{
  "$schema": "./schema/codec.schema.json",
  "version": 1,
  "description": "Realtime の codec 期待値。encode は JSON を意味比較（キー順は問わない）する。encode/decode/decodeFailures は翻訳接続（/v1/realtime/translations）、transcriptionEncode/transcriptionDecode は原文 transcription 接続（/v1/realtime?intent=transcription）。decodeFailures は「壊れた payload は必ず invalidMessage へ正規化する」ことを要求する正本であり、JSON parser 由来の例外をそのまま外へ出してはならない。",
  "encode": [
    {
      "name": "session.update english target with source transcription",
      "event": {
        "kind": "sessionUpdate",
        "outputLanguage": "en",
        "inputTranscriptionModel": "gpt-realtime-whisper",
        "noiseReduction": "far_field"
      },
      "expected": {
        "type": "session.update",
        "session": {
          "audio": {
            "output": {
              "language": "en"
            },
            "input": {
              "transcription": {
                "model": "gpt-realtime-whisper"
              },
              "noise_reduction": {
                "type": "far_field"
              }
            }
          }
        }
      }
    },
    {
      "name": "session.update japanese target without source transcription",
      "event": {
        "kind": "sessionUpdate",
        "outputLanguage": "ja",
        "inputTranscriptionModel": null,
        "noiseReduction": "near_field"
      },
      "expected": {
        "type": "session.update",
        "session": {
          "audio": {
            "output": {
              "language": "ja"
            },
            "input": {
              "noise_reduction": {
                "type": "near_field"
              }
            }
          }
        }
      }
    },
    {
      "name": "session.update spanish target without source transcription",
      "event": {
        "kind": "sessionUpdate",
        "outputLanguage": "es",
        "inputTranscriptionModel": null,
        "noiseReduction": "far_field"
      },
      "expected": {
        "type": "session.update",
        "session": {
          "audio": {
            "output": {
              "language": "es"
            },
            "input": {
              "noise_reduction": {
                "type": "far_field"
              }
            }
          }
        }
      }
    },
    {
      "name": "session.update noise reduction disabled emits explicit null",
      "event": {
        "kind": "sessionUpdate",
        "outputLanguage": "en",
        "inputTranscriptionModel": null,
        "noiseReduction": null
      },
      "expected": {
        "type": "session.update",
        "session": {
          "audio": {
            "output": {
              "language": "en"
            },
            "input": {
              "noise_reduction": null
            }
          }
        }
      }
    },
    {
      "name": "input audio buffer append",
      "event": {
        "kind": "inputAudioBufferAppend",
        "base64Audio": "AAECAwQF"
      },
      "expected": {
        "type": "session.input_audio_buffer.append",
        "audio": "AAECAwQF"
      }
    },
    {
      "name": "session close",
      "event": {
        "kind": "sessionClose"
      },
      "expected": {
        "type": "session.close"
      }
    }
  ],
  "decode": [
    {
      "name": "session.created",
      "json": "{\"type\":\"session.created\"}",
      "expected": {
        "kind": "sessionCreated"
      }
    },
    {
      "name": "session.updated",
      "json": "{\"type\":\"session.updated\"}",
      "expected": {
        "kind": "sessionUpdated"
      }
    },
    {
      "name": "input transcript delta with metadata",
      "json": "{\"type\":\"session.input_transcript.delta\",\"delta\":\"こんにちは\",\"event_id\":\"evt_1\",\"elapsed_ms\":1200}",
      "expected": {
        "kind": "inputTranscriptDelta",
        "delta": "こんにちは",
        "eventId": "evt_1",
        "elapsedMs": 1200
      }
    },
    {
      "name": "input transcript delta missing delta becomes empty string",
      "json": "{\"type\":\"session.input_transcript.delta\"}",
      "expected": {
        "kind": "inputTranscriptDelta",
        "delta": "",
        "eventId": null,
        "elapsedMs": null
      }
    },
    {
      "name": "output transcript delta with floating elapsed_ms truncates",
      "json": "{\"type\":\"session.output_transcript.delta\",\"delta\":\"Hello\",\"event_id\":\"evt_2\",\"elapsed_ms\":1999.9}",
      "expected": {
        "kind": "outputTranscriptDelta",
        "delta": "Hello",
        "eventId": "evt_2",
        "elapsedMs": 1999
      }
    },
    {
      "name": "output transcript delta with non numeric elapsed_ms is ignored",
      "json": "{\"type\":\"session.output_transcript.delta\",\"delta\":\"Hi\",\"elapsed_ms\":\"soon\"}",
      "expected": {
        "kind": "outputTranscriptDelta",
        "delta": "Hi",
        "eventId": null,
        "elapsedMs": null
      }
    },
    {
      "name": "output audio delta is a marker only",
      "json": "{\"type\":\"session.output_audio.delta\",\"audio\":\"AAECAwQF\"}",
      "expected": {
        "kind": "outputAudioDelta"
      }
    },
    {
      "name": "session.closed",
      "json": "{\"type\":\"session.closed\"}",
      "expected": {
        "kind": "sessionClosed"
      }
    },
    {
      "name": "error with nested error object",
      "json": "{\"type\":\"error\",\"error\":{\"message\":\"boom\",\"code\":\"server_error\"}}",
      "expected": {
        "kind": "error",
        "message": "boom",
        "code": "server_error"
      }
    },
    {
      "name": "error falls back to error.type when code is absent",
      "json": "{\"type\":\"error\",\"error\":{\"message\":\"boom\",\"type\":\"invalid_request_error\"}}",
      "expected": {
        "kind": "error",
        "message": "boom",
        "code": "invalid_request_error"
      }
    },
    {
      "name": "error falls back to top level message",
      "json": "{\"type\":\"error\",\"message\":\"top level\"}",
      "expected": {
        "kind": "error",
        "message": "top level",
        "code": null
      }
    },
    {
      "name": "error without any message uses default text",
      "json": "{\"type\":\"error\"}",
      "expected": {
        "kind": "error",
        "message": "翻訳サーバーでエラーが発生しました",
        "code": null
      }
    },
    {
      "name": "unknown event keeps its type",
      "json": "{\"type\":\"session.something_new\",\"foo\":1}",
      "expected": {
        "kind": "unknown",
        "type": "session.something_new"
      }
    }
  ],
  "transcriptionEncode": [
    {
      "name": "transcription session.update has its own session shape",
      "event": {
        "kind": "sessionUpdate",
        "noiseReduction": "far_field",
        "transcriptionDelay": "low",
        "prompt": "Japanese and English conversation.",
        "keywords": [
          "ハッカソン",
          "hackathon"
        ],
        "languages": [
          "ja",
          "en"
        ]
      },
      "expected": {
        "type": "session.update",
        "session": {
          "type": "transcription",
          "audio": {
            "input": {
              "format": {
                "type": "audio/pcm",
                "rate": 24000
              },
              "transcription": {
                "model": "gpt-live-transcribe",
                "languages": [
                  "ja",
                  "en"
                ],
                "delay": "low",
                "prompt": "Japanese and English conversation.",
                "keywords": [
                  "ハッカソン",
                  "hackathon"
                ]
              },
              "noise_reduction": {
                "type": "far_field"
              },
              "turn_detection": null
            }
          }
        }
      }
    },
    {
      "name": "transcription audio append has no session prefix",
      "event": {
        "kind": "inputAudioBufferAppend",
        "base64Audio": "AAECAwQF"
      },
      "expected": {
        "type": "input_audio_buffer.append",
        "audio": "AAECAwQF"
      }
    },
    {
      "name": "transcription stops with a commit instead of session.close",
      "event": {
        "kind": "commit"
      },
      "expected": {
        "type": "input_audio_buffer.commit"
      }
    },
    {
      "name": "transcription session.update accepts en-es languages",
      "event": {
        "kind": "sessionUpdate",
        "noiseReduction": "far_field",
        "transcriptionDelay": "low",
        "prompt": "Japanese and English conversation.",
        "keywords": [
          "ハッカソン",
          "hackathon"
        ],
        "languages": [
          "en",
          "es"
        ]
      },
      "expected": {
        "type": "session.update",
        "session": {
          "type": "transcription",
          "audio": {
            "input": {
              "format": {
                "type": "audio/pcm",
                "rate": 24000
              },
              "transcription": {
                "model": "gpt-live-transcribe",
                "languages": [
                  "en",
                  "es"
                ],
                "delay": "low",
                "prompt": "Japanese and English conversation.",
                "keywords": [
                  "ハッカソン",
                  "hackathon"
                ]
              },
              "noise_reduction": {
                "type": "far_field"
              },
              "turn_detection": null
            }
          }
        }
      }
    },
    {
      "name": "transcription session.update accepts ja-es languages",
      "event": {
        "kind": "sessionUpdate",
        "noiseReduction": "far_field",
        "transcriptionDelay": "low",
        "prompt": "Japanese and English conversation.",
        "keywords": [
          "ハッカソン",
          "hackathon"
        ],
        "languages": [
          "ja",
          "es"
        ]
      },
      "expected": {
        "type": "session.update",
        "session": {
          "type": "transcription",
          "audio": {
            "input": {
              "format": {
                "type": "audio/pcm",
                "rate": 24000
              },
              "transcription": {
                "model": "gpt-live-transcribe",
                "languages": [
                  "ja",
                  "es"
                ],
                "delay": "low",
                "prompt": "Japanese and English conversation.",
                "keywords": [
                  "ハッカソン",
                  "hackathon"
                ]
              },
              "noise_reduction": {
                "type": "far_field"
              },
              "turn_detection": null
            }
          }
        }
      }
    }
  ],
  "transcriptionDecode": [
    {
      "name": "source transcript delta",
      "json": "{\"type\":\"conversation.item.input_audio_transcription.delta\",\"delta\":\"こんにちは\",\"event_id\":\"evt_1\",\"item_id\":\"item_1\"}",
      "expected": {
        "kind": "inputTranscriptDelta",
        "delta": "こんにちは",
        "eventId": "evt_1",
        "elapsedMs": null
      }
    },
    {
      "name": "empty source delta is dropped",
      "json": "{\"type\":\"conversation.item.input_audio_transcription.delta\",\"delta\":\"\",\"event_id\":\"evt_2\"}",
      "expected": {
        "kind": "ignored"
      }
    },
    {
      "name": "completed marks the commit as drained",
      "json": "{\"type\":\"conversation.item.input_audio_transcription.completed\"}",
      "expected": {
        "kind": "transcriptionCompleted"
      }
    },
    {
      "name": "transcription errors are tagged with the transcription code",
      "json": "{\"type\":\"error\",\"error\":{\"message\":\"boom\",\"code\":\"server_error\"}}",
      "expected": {
        "kind": "error",
        "message": "boom",
        "code": "transcription"
      }
    },
    {
      "name": "translation event names are not understood here",
      "json": "{\"type\":\"session.input_transcript.delta\",\"delta\":\"x\"}",
      "expected": {
        "kind": "ignored"
      }
    }
  ],
  "decodeFailures": [
    {
      "name": "broken json",
      "json": "{\"type\":",
      "expectedError": "invalidMessage"
    },
    {
      "name": "json array instead of object",
      "json": "[1,2,3]",
      "expectedError": "invalidMessage"
    },
    {
      "name": "object without type",
      "json": "{\"delta\":\"x\"}",
      "expectedError": "invalidMessage"
    },
    {
      "name": "type is not a string",
      "json": "{\"type\":42}",
      "expectedError": "invalidMessage"
    },
    {
      "name": "empty payload",
      "json": "",
      "expectedError": "invalidMessage"
    }
  ]
}
