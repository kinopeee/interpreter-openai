{
  "$schema": "./schema/routing.schema.json",
  "version": 1,
  "description": "言語ペアの source lane と target wire 値による音声ルーティング期待値。pair 省略時は ja-en。frame は識別用のラベルで、実バイト列は任意。translationSendFailure は直後の appendFrame の翻訳送信を失敗させる（原文送信は成功する）。3 連続失敗で transport error を 1 回 emit し翻訳ポンプを停止、セッション再接続を合図する。",
  "prerollFrameLimit": 40,
  "consecutiveTranslationFailureLimit": 3,
  "scriptSwitchGate": {
    "minimumLatinWords": 4,
    "minimumLatinScalars": 16,
    "minimumJapaneseScalars": 2
  },
  "cases": [
    {
      "name": "before detection only the source connection receives audio",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2"],
        "frames": {
          "en": [],
          "ja": []
        }
      }
    },
    {
      "name": "japanese detection flushes preroll to the english target only",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": {
          "en": ["f1", "f2", "f3"],
          "ja": []
        }
      }
    },
    {
      "name": "english detection flushes preroll to the japanese target only",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "selectTranslationTarget", "target": "ja" },
        { "kind": "appendFrame", "frame": "f2" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2"],
        "frames": {
          "en": [],
          "ja": ["f1", "f2"]
        }
      }
    },
    {
      "name": "unknown language does not change routing",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "selectTranslationTarget", "target": null },
        { "kind": "appendFrame", "frame": "f2" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2"],
        "frames": {
          "en": [],
          "ja": []
        }
      }
    },
    {
      "name": "language switch flushes the rolling preroll to the new target",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "ja" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": {
          "en": ["f1", "f2"],
          "ja": ["f1", "f2", "f3"]
        }
      }
    },
    {
      "name": "setting the same language twice is a no-op",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "f2" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2"],
        "frames": {
          "en": ["f1", "f2"],
          "ja": []
        }
      }
    },
    {
      "name": "resetAudioRouting keeps the rolling preroll for the next detection",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "resetAudioRouting" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": {
          "en": ["f1", "f1", "f2", "f3"],
          "ja": []
        }
      }
    },
    {
      "name": "three consecutive translation send failures emit one transport error and halt translation",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "appendFrame", "frame": "afterHalt" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterHalt"],
        "frames": {
          "en": ["ok1"],
          "ja": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    },
    {
      "name": "a successful translation send resets the consecutive failure counter",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "appendFrame", "frame": "ok2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "appendFrame", "frame": "ok3" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "ok2", "fail3", "ok3"],
        "frames": {
          "en": ["ok1", "ok2", "ok3"],
          "ja": []
        },
        "transportErrorCount": 0,
        "translationPumpHalted": false,
        "signalsSessionReconnect": false
      }
    },
    {
      "name": "en-es selects spanish target after spanish evidence",
      "pair": "en-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "es-1" }
      ],
      "expected": {
        "sourceFrames": ["es-1"],
        "frames": { "en": [], "es": ["es-1"] }
      }
    },
    {
      "name": "en-es preroll flushes to spanish target",
      "pair": "en-es",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": { "en": [], "es": ["f1", "f2", "f3"] }
      }
    },
    {
      "name": "ja-es preroll flushes to spanish target",
      "pair": "ja-es",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": { "es": ["f1", "f2", "f3"], "ja": [] }
      }
    },
    {
      "name": "en-es preroll flushes to english target",
      "pair": "en-es",
      "steps": [
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": { "en": ["f1", "f2", "f3"], "es": [] }
      }
    },
    {
      "name": "ja-es language switch flushes the rolling preroll to the new target",
      "pair": "ja-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "ja" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": {
          "es": ["f1", "f2"],
          "ja": ["f1", "f2", "f3"]
        }
      }
    },
    {
      "name": "en-es language switch flushes the rolling preroll to the new target",
      "pair": "en-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "f1" },
        { "kind": "appendFrame", "frame": "f2" },
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "f3" }
      ],
      "expected": {
        "sourceFrames": ["f1", "f2", "f3"],
        "frames": {
          "es": ["f1", "f2"],
          "en": ["f1", "f2", "f3"]
        }
      }
    },
    {
      "name": "ja-es three consecutive spanish translation send failures emit one transport error and halt translation",
      "pair": "ja-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "appendFrame", "frame": "afterHalt" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterHalt"],
        "frames": {
          "es": ["ok1"],
          "ja": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    },
    {
      "name": "en-es three consecutive spanish translation send failures emit one transport error and halt translation",
      "pair": "en-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "appendFrame", "frame": "afterHalt" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterHalt"],
        "frames": {
          "es": ["ok1"],
          "en": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    },
    {
      "name": "en-es three consecutive english translation send failures emit one transport error and halt translation",
      "pair": "en-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "appendFrame", "frame": "afterHalt" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterHalt"],
        "frames": {
          "en": ["ok1"],
          "es": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    },
    {
      "name": "ja-es three consecutive japanese translation send failures emit one transport error and halt translation",
      "pair": "ja-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "ja" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "appendFrame", "frame": "afterHalt" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterHalt"],
        "frames": {
          "ja": ["ok1"],
          "es": [],
          "en": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    },
    {
      "name": "halted translation pump does not resume when the target switches",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "selectTranslationTarget", "target": "ja" },
        { "kind": "appendFrame", "frame": "afterSwitch" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterSwitch"],
        "frames": {
          "en": ["ok1"],
          "ja": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    },
    {
      "name": "ja-es halted translation pump does not resume when the target switches",
      "pair": "ja-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "selectTranslationTarget", "target": "ja" },
        { "kind": "appendFrame", "frame": "afterSwitch" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterSwitch"],
        "frames": {
          "es": ["ok1"],
          "ja": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    },
    {
      "name": "en-es halted translation pump does not resume when the target switches",
      "pair": "en-es",
      "steps": [
        { "kind": "selectTranslationTarget", "target": "en" },
        { "kind": "appendFrame", "frame": "ok1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail1" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail2" },
        { "kind": "translationSendFailure" },
        { "kind": "appendFrame", "frame": "fail3" },
        { "kind": "selectTranslationTarget", "target": "es" },
        { "kind": "appendFrame", "frame": "afterSwitch" }
      ],
      "expected": {
        "sourceFrames": ["ok1", "fail1", "fail2", "fail3", "afterSwitch"],
        "frames": {
          "en": ["ok1"],
          "es": []
        },
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true
      }
    }
  ],
  "targetSelectionDescription": "target は話者言語ではなく出力言語。話者言語は pair.counterpart(target) で求める。初回選択は従来どおり即時、en-es の稼働中切替は逆方向 evidence 2 回、ja-* の稼働中切替は candidate 以降の opposite script run を使う。",
  "targetSelection": [
    {
      "name": "en-es initial spanish evidence selects english target",
      "pair": "en-es",
      "evidence": [
        { "evidence": "spanish", "expectedTarget": "en" }
      ]
    },
    {
      "name": "en-es initial english evidence selects spanish target",
      "pair": "en-es",
      "evidence": [
        { "evidence": "english", "expectedTarget": "es" }
      ]
    },
    {
      "name": "en-es initial ambiguous latin selects nothing",
      "pair": "en-es",
      "evidence": [
        { "evidence": "ambiguousLatin", "expectedTarget": null }
      ]
    },
    {
      "name": "en-es one reverse evidence does not switch target",
      "pair": "en-es",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "english", "expectedTarget": "en" }
      ]
    },
    {
      "name": "en-es two consecutive reverse evidence switches target",
      "pair": "en-es",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "english", "expectedTarget": "en" },
        { "evidence": "english", "expectedTarget": "es" }
      ]
    },
    {
      "name": "en-es ambiguous evidence resets reverse counter",
      "pair": "en-es",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "english", "expectedTarget": "en" },
        { "evidence": "ambiguousLatin", "expectedTarget": "en" },
        { "evidence": "english", "expectedTarget": "en" },
        { "evidence": "english", "expectedTarget": "es" }
      ]
    },
    {
      "name": "en-es same language evidence keeps target",
      "pair": "en-es",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "spanish", "expectedTarget": "en", "expectedReverseEvidenceCount": 0 },
        { "evidence": "spanish", "expectedTarget": "en", "expectedReverseEvidenceCount": 0 }
      ]
    },
    {
      "name": "en-es same language evidence resets pending reverse count",
      "pair": "en-es",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "english", "expectedTarget": "en", "expectedReverseEvidenceCount": 1 },
        { "evidence": "spanish", "expectedTarget": "en", "expectedReverseEvidenceCount": 0 },
        { "evidence": "english", "expectedTarget": "en", "expectedReverseEvidenceCount": 1 },
        { "evidence": "english", "expectedTarget": "es", "expectedReverseEvidenceCount": 0 }
      ]
    },
    {
      "name": "ja-en one reverse evidence waits for the opposite run gate",
      "pair": "ja-en",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "japanese", "expectedTarget": "en" },
        { "evidence": "english", "oppositeRun": { "latinWords": 3, "latinScalars": 20, "japaneseScalars": 0 }, "expectedTarget": "en" },
        { "evidence": "english", "oppositeRun": { "latinWords": 4, "latinScalars": 21, "japaneseScalars": 0 }, "expectedTarget": "ja" }
      ]
    },
    {
      "name": "ja-es one reverse evidence waits for the opposite run gate",
      "pair": "ja-es",
      "initialTarget": "es",
      "evidence": [
        { "evidence": "japanese", "expectedTarget": "es" },
        { "evidence": "spanish", "oppositeRun": { "latinWords": 3, "latinScalars": 20, "japaneseScalars": 0 }, "expectedTarget": "es" },
        { "evidence": "spanish", "oppositeRun": { "latinWords": 4, "latinScalars": 21, "japaneseScalars": 0 }, "expectedTarget": "ja" }
      ]
    },
    {
      "name": "ja-en japanese evidence waits for two japanese scalars",
      "pair": "ja-en",
      "initialTarget": "ja",
      "evidence": [
        { "evidence": "english", "expectedTarget": "ja" },
        { "evidence": "japanese", "oppositeRun": { "latinWords": 0, "latinScalars": 0, "japaneseScalars": 1 }, "expectedTarget": "ja" },
        { "evidence": "japanese", "oppositeRun": { "latinWords": 0, "latinScalars": 0, "japaneseScalars": 2 }, "expectedTarget": "en" }
      ]
    },
    {
      "name": "ja-en english evidence without a candidate run does not flip",
      "pair": "ja-en",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "english", "expectedTarget": "en" },
        { "evidence": "english", "expectedTarget": "en" }
      ]
    },
    {
      "name": "ja-en initial ambiguous latin selects japanese target",
      "pair": "ja-en",
      "evidence": [
        { "evidence": "ambiguousLatin", "expectedTarget": "ja" }
      ]
    },
    {
      "name": "ja-es initial ambiguous latin selects japanese target",
      "pair": "ja-es",
      "evidence": [
        { "evidence": "ambiguousLatin", "expectedTarget": "ja" }
      ]
    },
    {
      "name": "ja-en initial english evidence selects japanese target without a run",
      "pair": "ja-en",
      "evidence": [
        { "evidence": "english", "expectedTarget": "ja" }
      ]
    },
    {
      "name": "ja-en mid stream ambiguous latin does not flip",
      "pair": "ja-en",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "ambiguousLatin", "expectedTarget": "en" }
      ]
    },
    {
      "name": "none evidence never changes target",
      "pair": "en-es",
      "initialTarget": "en",
      "evidence": [
        { "evidence": "none", "expectedTarget": "en" }
      ]
    }
  ],
  "switchStability": [
    {
      "name": "ja-en product name does not round trip on main",
      "pair": "ja-en",
      "initialTarget": "en",
      "splits": [
        {
          "deltas": ["あいうえおかきく Google Cloud Platform を使います"],
          "expectedSwitchAtDelta": null,
          "expectedSourceLengthAtSwitch": null
        },
        {
          "deltas": ["あいうえおかきく ", "Google ", "Cloud ", "Platform ", "を使います"],
          "expectedSwitchAtDelta": null,
          "expectedSourceLengthAtSwitch": null
        },
        {
          "deltas": ["あいうえおかきく G", "o", "o", "g", "l", "e ", "Cloud Platform ", "を使います"],
          "expectedSwitchAtDelta": null,
          "expectedSourceLengthAtSwitch": null
        }
      ],
      "expectedSwitchCount": 0,
      "expectedFinalTarget": "en",
      "expectedSplitOffset": null
    },
    {
      "name": "ja-es product name does not round trip on main",
      "pair": "ja-es",
      "initialTarget": "es",
      "splits": [
        {
          "deltas": ["あいうえおかきく Visual Studio Code を使います"],
          "expectedSwitchAtDelta": null,
          "expectedSourceLengthAtSwitch": null
        },
        {
          "deltas": ["あいうえおかきく ", "Visual ", "Studio ", "Code ", "を使います"],
          "expectedSwitchAtDelta": null,
          "expectedSourceLengthAtSwitch": null
        },
        {
          "deltas": ["あいうえおかきく V", "is", "ual Studio ", "Code を使", "います"],
          "expectedSwitchAtDelta": null,
          "expectedSourceLengthAtSwitch": null
        }
      ],
      "expectedSwitchCount": 0,
      "expectedFinalTarget": "es",
      "expectedSplitOffset": null
    },
    {
      "name": "ja-en long English phrase confirms a real speaker change",
      "pair": "ja-en",
      "initialTarget": "en",
      "splits": [
        {
          "deltas": ["あいうえおかきく Today it is sunny outside"],
          "expectedSwitchAtDelta": 0,
          "expectedSourceLengthAtSwitch": 34
        },
        {
          "deltas": ["あいうえおかきく ", "Today ", "it ", "is ", "sunny ", "outside"],
          "expectedSwitchAtDelta": 5,
          "expectedSourceLengthAtSwitch": 34
        },
        {
          "deltas": ["あいうえおかきく ", "Tod", "ay ", "it is ", "sun", "ny outside"],
          "expectedSwitchAtDelta": 5,
          "expectedSourceLengthAtSwitch": 34
        }
      ],
      "expectedSwitchCount": 1,
      "expectedFinalTarget": "ja",
      "expectedSplitOffset": 8
    },
    {
      "name": "ja-en short English reply stays ambiguous",
      "pair": "ja-en",
      "initialTarget": "en",
