{
  "$schema": "./schema/routing.schema.json",
  "version": 1,
  "description": "言語ペアの source lane と target wire 値による音声ルーティング期待値。pair 省略時は ja-en。frame は識別用ラベルで実バイト列は任意。",
  "prerollFrameLimit": 40,
  "consecutiveTranslationFailureLimit": 3,
  "cases": [
    {
      "name": "before detection only the source connection receives audio",
      "steps": [
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2"
        ],
        "frames": {
          "en": [],
          "ja": []
        }
      }
    },
    {
      "name": "japanese detection flushes preroll to the english target only",
      "steps": [
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        },
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "appendFrame",
          "frame": "f3"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2",
          "f3"
        ],
        "frames": {
          "en": [
            "f1",
            "f2",
            "f3"
          ],
          "ja": []
        }
      }
    },
    {
      "name": "english detection flushes preroll to the japanese target only",
      "steps": [
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "selectTranslationTarget",
          "target": "ja"
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2"
        ],
        "frames": {
          "en": [],
          "ja": [
            "f1",
            "f2"
          ]
        }
      }
    },
    {
      "name": "unknown language does not change routing",
      "steps": [
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "selectTranslationTarget",
          "target": null
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2"
        ],
        "frames": {
          "en": [],
          "ja": []
        }
      }
    },
    {
      "name": "language switch flushes the rolling preroll to the new target",
      "steps": [
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        },
        {
          "kind": "selectTranslationTarget",
          "target": "ja"
        },
        {
          "kind": "appendFrame",
          "frame": "f3"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2",
          "f3"
        ],
        "frames": {
          "en": [
            "f1",
            "f2"
          ],
          "ja": [
            "f1",
            "f2",
            "f3"
          ]
        }
      }
    },
    {
      "name": "setting the same language twice is a no-op",
      "steps": [
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2"
        ],
        "frames": {
          "en": [
            "f1",
            "f2"
          ],
          "ja": []
        }
      }
    },
    {
      "name": "resetAudioRouting keeps the rolling preroll for the next detection",
      "steps": [
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "resetAudioRouting"
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        },
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "appendFrame",
          "frame": "f3"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2",
          "f3"
        ],
        "frames": {
          "en": [
            "f1",
            "f1",
            "f2",
            "f3"
          ],
          "ja": []
        }
      }
    },
    {
      "name": "three consecutive translation send failures emit one transport error and halt translation",
      "steps": [
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "appendFrame",
          "frame": "ok1"
        },
        {
          "kind": "translationSendFailure"
        },
        {
          "kind": "appendFrame",
          "frame": "fail1"
        },
        {
          "kind": "translationSendFailure"
        },
        {
          "kind": "appendFrame",
          "frame": "fail2"
        },
        {
          "kind": "translationSendFailure"
        },
        {
          "kind": "appendFrame",
          "frame": "fail3"
        },
        {
          "kind": "appendFrame",
          "frame": "afterHalt"
        }
      ],
      "expected": {
        "sourceFrames": [
          "ok1",
          "fail1",
          "fail2",
          "fail3",
          "afterHalt"
        ],
        "transportErrorCount": 1,
        "translationPumpHalted": true,
        "signalsSessionReconnect": true,
        "frames": {
          "en": [
            "ok1"
          ],
          "ja": []
        }
      }
    },
    {
      "name": "a successful translation send resets the consecutive failure counter",
      "steps": [
        {
          "kind": "selectTranslationTarget",
          "target": "en"
        },
        {
          "kind": "appendFrame",
          "frame": "ok1"
        },
        {
          "kind": "translationSendFailure"
        },
        {
          "kind": "appendFrame",
          "frame": "fail1"
        },
        {
          "kind": "translationSendFailure"
        },
        {
          "kind": "appendFrame",
          "frame": "fail2"
        },
        {
          "kind": "appendFrame",
          "frame": "ok2"
        },
        {
          "kind": "translationSendFailure"
        },
        {
          "kind": "appendFrame",
          "frame": "fail3"
        },
        {
          "kind": "appendFrame",
          "frame": "ok3"
        }
      ],
      "expected": {
        "sourceFrames": [
          "ok1",
          "fail1",
          "fail2",
          "ok2",
          "fail3",
          "ok3"
        ],
        "transportErrorCount": 0,
        "translationPumpHalted": false,
        "signalsSessionReconnect": false,
        "frames": {
          "en": [
            "ok1",
            "ok2",
            "ok3"
          ],
          "ja": []
        }
      }
    },
    {
      "name": "en-es selects spanish target after spanish evidence",
      "pair": "en-es",
      "steps": [
        {
          "kind": "selectTranslationTarget",
          "target": "es"
        },
        {
          "kind": "appendFrame",
          "frame": "es-1"
        }
      ],
      "expected": {
        "sourceFrames": [
          "es-1"
        ],
        "frames": {
          "en": [],
          "es": [
            "es-1"
          ]
        }
      }
    },
    {
      "name": "en-es preroll flushes to spanish target",
      "pair": "en-es",
      "steps": [
        {
          "kind": "appendFrame",
          "frame": "f1"
        },
        {
          "kind": "appendFrame",
          "frame": "f2"
        },
        {
          "kind": "selectTranslationTarget",
          "target": "es"
        },
        {
          "kind": "appendFrame",
          "frame": "f3"
        }
      ],
      "expected": {
        "sourceFrames": [
          "f1",
          "f2",
          "f3"
        ],
        "frames": {
          "en": [],
          "es": [
            "f1",
            "f2",
            "f3"
          ]
        }
      }
    },
    {
      "name": "en-es one reverse evidence does not switch target",
      "pair": "en-es",
      "steps": [
        {
          "kind": "selectTranslationTarget",
          "target": "es"
        },
        {
          "kind": "evaluateEvidence",
          "evidence": "english"
        },
        {
          "kind": "appendFrame",
          "frame": "still-es"
        }
      ],
      "expected": {
        "sourceFrames": [
          "still-es"
        ],
        "frames": {
          "en": [],
          "es": [
            "still-es"
          ]
        },
        "selectedTarget": "es"
      }
    },
    {
      "name": "en-es two consecutive reverse evidence switches target",
      "pair": "en-es",
      "steps": [
        {
          "kind": "selectTranslationTarget",
          "target": "es"
        },
        {
          "kind": "evaluateEvidence",
          "evidence": "english"
        },
        {
          "kind": "evaluateEvidence",
          "evidence": "english"
        },
        {
          "kind": "appendFrame",
          "frame": "now-en"
        }
      ],
      "expected": {
        "sourceFrames": [
          "now-en"
        ],
        "frames": {
          "en": [
            "now-en"
          ],
          "es": []
        },
        "selectedTarget": "en"
      }
    }
  ],
  "prerollWindow": {
    "name": "the rolling preroll keeps at most 40 frames",
    "appendFrameCount": 60,
    "expectedFlushedFrameCount": 40,
    "expectedFirstFlushedFrameIndex": 20,
    "expectedLastFlushedFrameIndex": 59,
    "thenSelectTranslationTarget": "en"
  }
}
