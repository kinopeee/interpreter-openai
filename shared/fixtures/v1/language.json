{
  "$schema": "./schema/language.schema.json",
  "version": 1,
  "description": "SpokenLanguageDetector の期待値。pair 省略時は ja-en。evidence は japanese/english/spanish/ambiguousLatin/none、detect は japanese/english/spanish/unknown。",
  "recentEvidenceWindow": 16,
  "evidence": [
    {
      "name": "hiragana",
      "input": "こんにちは",
      "evidence": "japanese",
      "detect": "japanese"
    },
    {
      "name": "katakana",
      "input": "カタカナ",
      "evidence": "japanese",
      "detect": "japanese"
    },
    {
      "name": "kanji",
      "input": "東京",
      "evidence": "japanese",
      "detect": "japanese"
    },
    {
      "name": "japanese wins over latin words",
      "input": "こんにちは world today",
      "evidence": "japanese",
      "detect": "japanese"
    },
    {
      "name": "two latin words are english",
      "input": "Hello world",
      "evidence": "english",
      "detect": "english"
    },
    {
      "name": "single latin word is ambiguous",
      "input": "Hello",
      "evidence": "ambiguousLatin",
      "detect": "unknown"
    },
    {
      "name": "single latin word with punctuation stays ambiguous",
      "input": "Hello!!!",
      "evidence": "ambiguousLatin",
      "detect": "unknown"
    },
    {
      "name": "hyphen splits latin words",
      "input": "well-known",
      "evidence": "english",
      "detect": "english"
    },
    {
      "name": "digits only",
      "input": "123 456",
      "evidence": "none",
      "detect": "unknown"
    },
    {
      "name": "empty",
      "input": "",
      "evidence": "none",
      "detect": "unknown"
    },
    {
      "name": "whitespace only",
      "input": "   ",
      "evidence": "none",
      "detect": "unknown"
    },
    {
      "name": "fullwidth punctuation only",
      "input": "、。！",
      "evidence": "none",
      "detect": "unknown"
    },
    {
      "name": "en-es exclusive spanish words confirm spanish",
      "pair": "en-es",
      "input": "el tren está aquí",
      "evidence": "spanish",
      "detect": "spanish"
    },
    {
      "name": "en-es exclusive english words confirm english",
      "pair": "en-es",
      "input": "the train is here",
      "evidence": "english",
      "detect": "english"
    },
    {
      "name": "en-es common words stay ambiguous",
      "pair": "en-es",
      "input": "no a me he son sin un",
      "evidence": "ambiguousLatin",
      "detect": "unknown"
    },
    {
      "name": "en-es accent vowels confirm spanish",
      "pair": "en-es",
      "input": "está aquí más",
      "evidence": "spanish",
      "detect": "spanish"
    },
    {
      "name": "en-es inverted punctuation confirms spanish",
      "pair": "en-es",
      "input": "¿Dónde estás?",
      "evidence": "spanish",
      "detect": "spanish"
    },
    {
      "name": "en-es cjk noise is ignored",
      "pair": "en-es",
      "input": "東京 hello world",
      "evidence": "ambiguousLatin",
      "detect": "unknown"
    },
    {
      "name": "ja-es latin words are spanish",
      "pair": "ja-es",
      "input": "こんにちは mundo ahora",
      "evidence": "spanish",
      "detect": "spanish"
    }
  ],
  "recentEvidence": [
    {
      "name": "japanese scrolled out of the window yields english",
      "input": "こんにちは。 This is an English sentence now",
      "window": 16,
      "expected": "english",
      "fullEvidence": "japanese"
    },
    {
      "name": "recent japanese inside the window",
      "input": "Hello world こんにちは",
      "window": 16,
      "expected": "japanese",
      "fullEvidence": "japanese"
    },
    {
      "name": "whitespace only input has no evidence",
      "input": "     ",
      "window": 16,
      "expected": "none",
      "fullEvidence": "none"
    },
    {
      "name": "short input falls back to full evidence",
      "input": "Hi there",
      "window": 16,
      "expected": "english",
      "fullEvidence": "english"
    },
    {
      "name": "window zero falls back to full evidence",
      "input": "こんにちは world today",
      "window": 0,
      "expected": "japanese",
      "fullEvidence": "japanese"
    },
    {
      "name": "whitespace is preserved so word boundaries survive",
      "input": "aaaaaaaaaaaaaaaaaaaa bb cc",
      "window": 16,
      "expected": "english",
      "fullEvidence": "english"
    }
  ],
  "targets": [
    {
      "pair": "ja-en",
      "languages": [
        "ja",
        "en"
      ],
      "mappings": [
        {
          "language": "japanese",
          "translationTarget": "en",
          "counterpart": "english"
        },
        {
          "language": "english",
          "translationTarget": "ja",
          "counterpart": "japanese"
        }
      ]
    },
    {
      "pair": "ja-es",
      "languages": [
        "ja",
        "es"
      ],
      "mappings": [
        {
          "language": "japanese",
          "translationTarget": "es",
          "counterpart": "spanish"
        },
        {
          "language": "spanish",
          "translationTarget": "ja",
          "counterpart": "japanese"
        }
      ]
    },
    {
      "pair": "en-es",
      "languages": [
        "en",
        "es"
      ],
      "mappings": [
        {
          "language": "english",
          "translationTarget": "es",
          "counterpart": "spanish"
        },
        {
          "language": "spanish",
          "translationTarget": "en",
          "counterpart": "english"
        }
      ]
    }
  ],
  "enEsWindow": 8,
  "exclusiveWords": {
    "es": [
      "el",
      "la",
      "los",
      "las",
      "es",
      "está",
      "que",
      "y",
      "de",
      "del",
      "con",
      "por",
      "para",
      "pero",
      "más",
      "sí"
    ],
    "en": [
      "the",
      "and",
      "is",
      "are",
      "of",
      "to",
      "it",
      "that",
      "this",
      "with",
      "for",
      "you",
      "they"
    ]
  }
}
