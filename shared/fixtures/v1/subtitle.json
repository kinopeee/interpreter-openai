{
  "$schema": "./schema/subtitle.schema.json",
  "version": 1,
  "description": "SubtitleTailClipper と字幕整列の期待値。長い文字列は literal / repeat / concat 記法で表現する。assembler.cases の expectedFinal は「最後に返された非 null の update」の内容を表す（step が null を返した場合はそれ以前の update を保持）。at は秒。",
  "limits": {
    "japaneseCharacterLimit": 60,
    "englishCharacterLimit": 120,
    "ellipsis": "…"
  },
  "clip": [
    {
      "name": "short japanese is unchanged",
      "input": { "literal": "こんにちは、世界。" },
      "expected": { "literal": "こんにちは、世界。" }
    },
    {
      "name": "short english is unchanged",
      "input": { "literal": "Hello world" },
      "expected": { "literal": "Hello world" }
    },
    {
      "name": "surrounding whitespace is trimmed",
      "input": { "literal": "  Hello world \n" },
      "expected": { "literal": "Hello world" }
    },
    {
      "name": "whitespace only input is returned as is",
      "input": { "literal": "   " },
      "expected": { "literal": "   " }
    },
    {
      "name": "empty input is returned as is",
      "input": { "literal": "" },
      "expected": { "literal": "" }
    },
    {
      "name": "japanese exactly at the limit is unchanged",
      "input": { "repeat": "あ", "count": 60 },
      "expected": { "repeat": "あ", "count": 60 }
    },
    {
      "name": "japanese over the limit keeps the tail with an ellipsis",
      "input": { "repeat": "あ", "count": 70 },
      "expected": { "concat": [{ "literal": "…" }, { "repeat": "あ", "count": 60 }] }
    },
    {
      "name": "mixed text containing cjk uses the japanese limit",
      "input": { "concat": [{ "literal": "あ" }, { "repeat": "a", "count": 100 }] },
      "expected": { "concat": [{ "literal": "…" }, { "repeat": "a", "count": 60 }] }
    },
    {
      "name": "english over the limit drops the leading partial word",
      "input": { "repeat": "abcdefghij ", "count": 15 },
      "expected": {
        "concat": [
          { "literal": "…" },
          { "repeat": "abcdefghij ", "count": 9 },
          { "literal": "abcdefghij" }
        ]
      }
    },
    {
      "name": "english single long token has no space to drop",
      "input": { "repeat": "a", "count": 130 },
      "expected": { "concat": [{ "literal": "…" }, { "repeat": "a", "count": 120 }] }
    },
    {
      "name": "short spanish is unchanged",
      "input": { "literal": "Hola mundo" },
      "expected": { "literal": "Hola mundo" }
    },
    {
      "name": "spanish accented text is unchanged",
      "input": { "literal": "¿Cómo estás? ¡Bien!" },
      "expected": { "literal": "¿Cómo estás? ¡Bien!" }
    }
  ],
  "assembler": {
    "idleFinalizeSeconds": 8,
    "cases": [
      {
        "name": "source only does not finalize without a translation",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s1", "elapsedMs": 100 },
          { "at": 9, "kind": "tick" }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは",
          "translatedText": "",
          "isTranslationCurrent": false,
          "shouldFinalize": false
        }
      },
      {
        "name": "complete pair finalizes after the idle interval",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.2, "kind": "translationDelta", "lane": "en", "text": "Hello", "eventId": "t1", "elapsedMs": 200 },
          { "at": 9, "kind": "tick" }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは",
          "translatedText": "Hello",
          "isTranslationCurrent": true,
          "shouldFinalize": true
        }
      },
      {
        "name": "expected lane wins over the echo lane",
        "epoch": 1,
        "expectLane": "ja",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "Hello there", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.1, "kind": "translationDelta", "lane": "en", "text": "Hello there", "eventId": "t-echo", "elapsedMs": 150 },
          { "at": 0.2, "kind": "translationDelta", "lane": "ja", "text": "こんにちは", "eventId": "t1", "elapsedMs": 200 }
        ],
        "expectedFinal": {
          "sourceText": "Hello there",
          "translatedText": "こんにちは",
          "isTranslationCurrent": true,
          "shouldFinalize": false
        }
      },
      {
        "name": "events from another epoch are ignored",
        "epoch": 2,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "stale", "eventId": "s0", "elapsedMs": 10, "epoch": 1 },
          { "at": 0.1, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s1", "elapsedMs": 100 }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは",
          "translatedText": "",
          "isTranslationCurrent": false,
          "shouldFinalize": false
        }
      },
      {
        "name": "duplicate event ids are ignored",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "あい", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.1, "kind": "sourceDelta", "lane": "source", "text": "あい", "eventId": "s1", "elapsedMs": 100 }
        ],
        "expectedFinal": {
          "sourceText": "あい",
          "translatedText": "",
          "isTranslationCurrent": false,
          "shouldFinalize": false
        }
      },
      {
        "name": "language switch finalizes a complete pair",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.2, "kind": "translationDelta", "lane": "en", "text": "Hello", "eventId": "t1", "elapsedMs": 200 },
          { "at": 0.3, "kind": "finalizeForLanguageSwitch" }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは",
          "translatedText": "Hello",
          "isTranslationCurrent": true,
          "shouldFinalize": true
        }
      },
      {
        "name": "language switch finalizes a stale pair after source continues",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.2, "kind": "translationDelta", "lane": "en", "text": "Hello", "eventId": "t1", "elapsedMs": 200 },
          { "at": 0.4, "kind": "sourceDelta", "lane": "source", "text": "、皆さん", "eventId": "s2", "elapsedMs": 300 },
          { "at": 0.5, "kind": "finalizeForLanguageSwitch" }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは、皆さん",
          "translatedText": "Hello",
          "isTranslationCurrent": true,
          "shouldFinalize": true
        }
      },
      {
        "name": "language switch without pair clears buffers for the next source",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.1, "kind": "finalizeForLanguageSwitch" },
          { "at": 0.2, "kind": "sourceDelta", "lane": "source", "text": "Hello there", "eventId": "s2", "elapsedMs": 200 }
        ],
        "expectedFinal": {
          "sourceText": "Hello there",
          "translatedText": "",
          "isTranslationCurrent": false,
          "shouldFinalize": false
        }
      },
      {
        "name": "stale idle does not concatenate the next source",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.2, "kind": "translationDelta", "lane": "en", "text": "Hello", "eventId": "t1", "elapsedMs": 200 },
          { "at": 0.4, "kind": "sourceDelta", "lane": "source", "text": "、皆さん", "eventId": "s2", "elapsedMs": 300 },
          { "at": 9, "kind": "tick" },
          { "at": 9.2, "kind": "sourceDelta", "lane": "source", "text": "ありがとう", "eventId": "s3", "elapsedMs": 400 }
        ],
        "expectedFinal": {
          "sourceText": "ありがとう",
          "translatedText": "",
          "isTranslationCurrent": false,
          "shouldFinalize": false
        }
      },
      {
        "name": "late translation after idle finalize is ignored until next source",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは。", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.2, "kind": "translationDelta", "lane": "en", "text": "Hello.", "eventId": "t1", "elapsedMs": 200 },
          { "at": 9, "kind": "tick" },
          { "at": 9.1, "kind": "translationDelta", "lane": "en", "text": " Late", "eventId": "t2", "elapsedMs": 300 }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは。",
          "translatedText": "Hello.",
          "isTranslationCurrent": true,
          "shouldFinalize": true
        }
      },
      {
        "name": "mid idle pause does not finalize a complete pair",
        "epoch": 1,
        "expectLane": "ja",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "hello world", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.2, "kind": "translationDelta", "lane": "ja", "text": "こんにちは世界", "eventId": "t1", "elapsedMs": 200 },
          { "at": 5.5, "kind": "tick" }
        ],
        "expectedFinal": {
          "sourceText": "hello world",
          "translatedText": "こんにちは世界",
          "isTranslationCurrent": true,
          "shouldFinalize": false
        }
      },
      {
        "name": "first output lane wins when both eventually emit",
        "epoch": 1,
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "Tokyo", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.1, "kind": "translationDelta", "lane": "en", "text": "Tokyo", "eventId": "e1", "elapsedMs": 150 },
          { "at": 0.2, "kind": "translationDelta", "lane": "ja", "text": "東京", "eventId": "j1", "elapsedMs": 200 }
        ],
        "expectedFinal": {
          "sourceText": "Tokyo",
          "translatedText": "Tokyo",
          "isTranslationCurrent": true,
          "shouldFinalize": false
        }
      },
      {
        "name": "selected lane silence in mixed speech still displays source",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "今日は", "eventId": "s1", "elapsedMs": 100 },
          { "at": 0.1, "kind": "translationDelta", "lane": "en", "text": "Today", "eventId": "t1", "elapsedMs": 150 },
          { "at": 0.2, "kind": "sourceDelta", "lane": "source", "text": " meeting", "eventId": "s2", "elapsedMs": 200 },
          { "at": 0.3, "kind": "translationDelta", "lane": "ja", "text": "会議", "eventId": "j1", "elapsedMs": 250 }
        ],
        "expectedFinal": {
          "sourceText": "今日は meeting",
          "translatedText": "Today",
          "isTranslationCurrent": false,
          "shouldFinalize": false
        }
      },
      {
        "name": "shared elapsed ms allows multiple source deltas",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "Hi", "eventId": "s1", "elapsedMs": 5 },
          { "at": 0.1, "kind": "sourceDelta", "lane": "source", "text": " there", "eventId": "s2", "elapsedMs": 5 }
        ],
        "expectedFinal": {
          "sourceText": "Hi there",
          "translatedText": "",
          "isTranslationCurrent": false,
          "shouldFinalize": false
        }
      },
      {
        "name": "punctuation does not finalize a streaming complete pair",
        "epoch": 1,
        "expectLane": "en",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは。", "eventId": "s1", "elapsedMs": 1 },
          { "at": 0.1, "kind": "translationDelta", "lane": "en", "text": "Hello.", "eventId": "t1", "elapsedMs": 2 },
          { "at": 0.5, "kind": "tick" }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは。",
          "translatedText": "Hello.",
          "isTranslationCurrent": true,
          "shouldFinalize": false
        }
      },
      {
        "name": "spanish translation lane is selected explicitly",
        "epoch": 1,
        "expectLane": "es",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "こんにちは", "eventId": "s-es", "elapsedMs": 100 },
          { "at": 0.2, "kind": "translationDelta", "lane": "es", "text": "Hola", "eventId": "t-es", "elapsedMs": 200 }
        ],
        "expectedFinal": {
          "sourceText": "こんにちは",
          "translatedText": "Hola",
          "isTranslationCurrent": true,
          "shouldFinalize": false
        }
      },
      {
        "name": "expected spanish lane wins over japanese echo",
        "epoch": 1,
        "expectLane": "es",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "これは会議です", "eventId": "s-es-echo", "elapsedMs": 100 },
          { "at": 0.1, "kind": "translationDelta", "lane": "ja", "text": "これは会議です", "eventId": "t-ja-echo", "elapsedMs": 150 },
          { "at": 0.2, "kind": "translationDelta", "lane": "es", "text": "Esta es una reunión", "eventId": "t-es-real", "elapsedMs": 200 }
        ],
        "expectedFinal": {
          "sourceText": "これは会議です",
          "translatedText": "Esta es una reunión",
          "isTranslationCurrent": true,
          "shouldFinalize": false
        }
      },
      {
        "name": "expected spanish lane wins over english echo",
        "epoch": 1,
        "expectLane": "es",
        "steps": [
          { "at": 0, "kind": "sourceDelta", "lane": "source", "text": "the meeting starts now", "eventId": "s-en-echo", "elapsedMs": 100 },
          { "at": 0.1, "kind": "translationDelta", "lane": "en", "text": "the meeting starts now", "eventId": "t-en-echo", "elapsedMs": 150 },
          { "at": 0.2, "kind": "translationDelta", "lane": "es", "text": "la reunión empieza ahora", "eventId": "t-es-real", "elapsedMs": 200 }
        ],
        "expectedFinal": {
          "sourceText": "the meeting starts now",
          "translatedText": "la reunión empieza ahora",
          "isTranslationCurrent": true,
          "shouldFinalize": false
        }
      }
    ]
  }
}
